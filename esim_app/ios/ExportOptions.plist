<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Development build: signed with the iPhone Developer certificate and the
	  `onlylink` provisioning profile (team PVM5YXK3HX), which pins two device
	  UDIDs. `app-store-connect` / `ad-hoc` would both be rejected here -- those
	  methods require an Apple Distribution certificate, and we only have a
	  development one. This produces an IPA that installs on the registered
	  devices only, and the profile expires 2026-11-16.

	  Change `method` to `app-store-connect` once an Apple Distribution
	  certificate exists for this team.
	-->
	<key>method</key>
	<string>development</string>
	<key>teamID</key>
	<string>PVM5YXK3HX</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>iPhone Developer</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.esimshop.esimApp</key>
		<string>onlylink</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>compileBitcode</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
